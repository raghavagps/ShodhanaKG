<VirtualHost *:80>
    ServerName yourdomain.com
    DocumentRoot ./webservice/frontend/dist

    # Backend API Alias (if needed, otherwise accessed via /api subdirectory)
    # Alias /raghava/shodhanakg/api ./webservice/api

    <Directory ./webservice/frontend/dist>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    <Directory ./webservice/api>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # Compression (mod_deflate)
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
    </IfModule>

    # Environment Variables for Backend
    SetEnv ARCADE_URL http://localhost:2480
    SetEnv ARCADE_DB shodhana
    SetEnv ARCADE_USER "username"
    SetEnv ARCADE_PASS "password"
    SetEnv ALLOWED_ORIGINS "*"

    # LLM Settings for Chatbot (Optional)
    SetEnv OLLAMA_URL "http://localhost:11434"
    SetEnv OLLAMA_MODEL "llama3.2"

    ErrorLog ${APACHE_LOG_DIR}/shodhanakg_error.log
    CustomLog ${APACHE_LOG_DIR}/shodhanakg_access.log combined

    # SSL (Managed by Certbot)
    # SSLEngine on
    # SSLCertificateFile ./ssl/fullchain.pem
    # SSLCertificateKeyFile ./ssl/privkey.pem
</VirtualHost>
