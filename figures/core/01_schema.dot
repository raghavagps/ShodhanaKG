digraph schema {
	bgcolor=white compound=true concentrate=false fontname=Arial nodesep=.6 pad=.3 rankdir=LR ranksep=1.4 splines=spline
	node [fontname=Arial fontsize=12 margin=".15,.1" penwidth=.8 shape=box style=rounded]
	edge [arrowsize=.7 color="#7C858D" fontname=Arial fontsize=9 penwidth=.65]
	subgraph cluster_compound {
		color="#176B50" fontcolor="#176B50" fontsize=16 label="Compound Shodhana" margin=25 style=rounded
		Ayurvedic_Formulation [label="Ayurvedic Formulation" color="#176B50" id="class-Ayurvedic_Formulation"]
		Compound [label=Compound color="#176B50" id="class-Compound"]
		Confirmation_Study [label="Confirmation Study" color="#176B50" id="class-Confirmation_Study"]
		Indication [label=Indication color="#176B50" id="class-Indication"]
		Media [label=Media color="#176B50" id="class-Media"]
		Process [label=Process color="#176B50" id="class-Process"]
		Purified_Compound [label="Purified Compound" color="#176B50" id="class-Purified_Compound"]
		Shodhana_Method [label="Shodhana Method" color="#176B50" id="class-Shodhana_Method"]
		Shodhana_Type [label="Shodhana Type" color="#176B50" id="class-Shodhana_Type"]
		Toxic_Substance [label="Toxic Substance" color="#176B50" id="class-Toxic_Substance"]
	}
	subgraph cluster_disease {
		color="#2166A0" fontcolor="#2166A0" fontsize=16 label="Disease Shodhana" margin=25 style=rounded
		Assessment_Parameter [label="Assessment Parameter" color="#2166A0" id="class-Assessment_Parameter"]
		Ayurvedic_Diagnosis [label="Ayurvedic Diagnosis" color="#2166A0" id="class-Ayurvedic_Diagnosis"]
		Disease [label=Disease color="#2166A0" id="class-Disease"]
		Dosha [label=Dosha color="#2166A0" id="class-Dosha"]
		Formulation [label=Formulation color="#2166A0" id="class-Formulation"]
		Symptom [label=Symptom color="#2166A0" id="class-Symptom"]
		Therapy [label=Therapy color="#2166A0" id="class-Therapy"]
	}
	Assessment_Parameter -> Disease [label=ASSESS color="#7C858D" constraint=true id="schema-edge-a57d15ace01be3d941b8" penwidth=.65 weight=1]
	Compound -> Toxic_Substance [label=CONTAINS color="#7C858D" constraint=true id="schema-edge-c25bf082df78028a0aaf" penwidth=.65 weight=1]
	Compound -> Shodhana_Method [label=UNDERGOES color="#7C858D" constraint=true id="schema-edge-ed3056ee78861885ea4f" penwidth=.65 weight=1]
	Confirmation_Study -> Purified_Compound [label="CONFIRMS SAFETY OF" color="#7C858D" constraint=true id="schema-edge-5042a5b1d7ec81db0319" penwidth=.65 weight=1]
	Disease -> Ayurvedic_Diagnosis [label="HAS AYURVEDIC DIAGNOSIS" color="#7C858D" constraint=true id="schema-edge-ade3777fb1560c706787" penwidth=.65 weight=1]
	Disease -> Dosha [label="HAS DOSHA IMBALANCE" color="#7C858D" constraint=true id="schema-edge-99e55603911f578acc40" penwidth=.65 weight=1]
	Disease -> Symptom [label="HAS SYMPTOM" color="#7C858D" constraint=true id="schema-edge-bb74f64e7ea9cd1ce670" penwidth=.65 weight=1]
	Disease -> Therapy [label="POST TREATED BY" color="#7C858D" constraint=true id="schema-edge-41ab663ebef23c328cb3" penwidth=.65 weight=1]
	Disease -> Therapy [label="PRE TREATED BY" color="#7C858D" constraint=true id="schema-edge-21e45fd9e919f098d9f9" penwidth=.65 weight=1]
	Disease -> Therapy [label="TREATED BY" color="#7C858D" constraint=true id="schema-edge-54db12e54cd7a9a39c6a" penwidth=.65 weight=1]
	Process -> Process [label="FOLLOWED BY" color="#7C858D" constraint=true id="schema-edge-4920f19f5493870cbe4d" penwidth=.65 weight=1]
	Process -> Purified_Compound [label=PRODUCES color="#7C858D" constraint=true id="schema-edge-46d55bbe067bb588875a" penwidth=.65 weight=1]
	Process -> Media [label="USES MEDIA" color="#7C858D" constraint=true id="schema-edge-f258ddc4052a02ae0ee1" penwidth=.65 weight=1]
	Process -> Confirmation_Study [label="VALIDATED BY" color="#7C858D" constraint=true id="schema-edge-bb3414d0a451c6111337" penwidth=.65 weight=1]
	Purified_Compound -> Compound [label="DERIEVED FROM" color="#7C858D" constraint=false id="schema-edge-4aef827158f643c10a1c" penwidth=.65 weight=1]
	Purified_Compound -> Indication [label=TREATS color="#7C858D" constraint=true id="schema-edge-0d057e8b53a20ed3d6dd" penwidth=.65 weight=1]
	Purified_Compound -> Disease [label="USED FOR TREATMENT" color="#A65E00" constraint=true id="schema-edge-ad989d759d4b73b34c20" penwidth=1.8 weight=100]
	Purified_Compound -> Ayurvedic_Formulation [label="USED IN FORMULATION" color="#7C858D" constraint=true id="schema-edge-3f48a75ef1b0ea015ef5" penwidth=.65 weight=1]
	Shodhana_Method -> Shodhana_Type [label="CLASSIFIED AS" color="#7C858D" constraint=true id="schema-edge-7d0991730bfb7b72b897" penwidth=.65 weight=1]
	Shodhana_Method -> Toxic_Substance [label=DETOXIFIES color="#7C858D" constraint=true id="schema-edge-7fdecd80bb8ebeafaac5" penwidth=.65 weight=1]
	Shodhana_Method -> Process [label="FOLLOWED BY" color="#7C858D" constraint=true id="schema-edge-3618f0a05be2582d4242" penwidth=.65 weight=1]
	Shodhana_Method -> Purified_Compound [label=PRODUCES color="#7C858D" constraint=true id="schema-edge-f26ac47eb97a78cf6188" penwidth=.65 weight=1]
	Shodhana_Method -> Media [label="USES MEDIA" color="#7C858D" constraint=true id="schema-edge-7a64acb0866470013230" penwidth=.65 weight=1]
	Shodhana_Method -> Confirmation_Study [label="VALIDATED BY" color="#7C858D" constraint=true id="schema-edge-ac6c660df48b19ed588a" penwidth=.65 weight=1]
	Therapy -> Formulation [label="USES FORMULATION" color="#7C858D" constraint=true id="schema-edge-aa9439a630fd2162c70e" penwidth=.65 weight=1]
	Indication -> Assessment_Parameter [id="layout-only-domain-order" minlen=2 style=invis weight=10]
	Ayurvedic_Formulation -> Assessment_Parameter [id="layout-only-domain-order-2" minlen=2 style=invis weight=10]
}
