# =============================================================================
# ShodhanaKG Production Environment Configuration (Example)
# Copy this file to .env or .env.production and adjust with production values.
# =============================================================================

# Frontend Server & Build
FRONTEND_HOST=localhost
FRONTEND_PORT=8080
VITE_API_BASE=/APP_BASE_PATH
VITE_CHAT_ENABLED=true

# Backend API Server
API_HOST=127.0.0.1
API_PORT=8081
API_PROXY_TARGET=http://127.0.0.1:8081
API_STORAGE_DIR=webservice/api/storage
API_CACHE_DIR=webservice/api/storage/cache
API_VERSION=v1
ALLOWED_ORIGINS=https://webs.iiitd.edu.in

# ArcadeDB Database Connection
ARCADE_HOST=localhost
ARCADE_PORT=2480
ARCADE_URL=http://localhost:2480
ARCADE_DB=IntegratedKG
ARCADE_USER=username
ARCADE_PASS=password

# Ollama / Chatbot LLM
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_KEEP_ALIVE=5m
