# =============================================================================
# FRONTEND: .env.production
# Use these when running 'npm run build'
# =============================================================================
VITE_API_BASE=/raghava/shodhanakg
VITE_CHAT_ENABLED=true

# =============================================================================
# BACKEND: Server Environment Variables
# Set these in your web server (Nginx/Apache) or shell
# =============================================================================

# ArcadeDB Connection
ARCADE_URL=http://localhost:2480
ARCADE_DB=shodhana
ARCADE_USER=prod_user
ARCADE_PASS=secure_password_here

# Ollama / LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Security & CORS
ALLOWED_ORIGINS=https://shodhanakg.org

# Storage
API_STORAGE_DIR=/usr1/gpsr/webserver/cgidocs/raghava/shodhanakg/api/storage
API_VERSION=v1
